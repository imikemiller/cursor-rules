🛡️ Field ID Validation Script
Use this script to validate your field IDs before creation:

#!/bin/bash

# Field ID Validator for Jira Story Creation
# Usage: ./validate-ids.sh <team_id> <component_id>

TEAM_ID=$1
COMPONENT_ID=$2

echo "Validating Field IDs..."
echo "========================"
echo ""

# Validate Team ID (customfield_10972)
if [[ "$TEAM_ID" =~ ^(11559|11560|11561)$ ]]; then
    case $TEAM_ID in
        11559) echo "✅ Team ID: 11559 (Stallions) - VALID";;
        11560) echo "✅ Team ID: 11560 (Control-Freaks) - VALID";;
        11561) echo "✅ Team ID: 11561 (Infra) - VALID";;
    esac
else
    echo "❌ Team ID: $TEAM_ID - INVALID!"
    echo "   Must be: 11559, 11560, or 11561"
    exit 1
fi

# Validate Component ID (customfield_10970)
if [[ "$COMPONENT_ID" =~ ^(11554|11555|11556|11557|11558)$ ]]; then
    case $COMPONENT_ID in
        11554) echo "✅ Component ID: 11554 (Control Interface) - VALID";;
        11555) echo "✅ Component ID: 11555 (Aave) - VALID";;
        11556) echo "✅ Component ID: 11556 (Cooper Integration) - VALID";;
        11557) echo "✅ Component ID: 11557 (Canton/Cumberland) - VALID";;
        11558) echo "✅ Component ID: 11558 (Infra) - VALID";;
    esac
else
    echo "❌ Component ID: $COMPONENT_ID - INVALID!"
    echo "   Must be: 11554, 11555, 11556, 11557, or 11558"
    exit 1
fi

echo ""
echo "========================"
echo "✅ ALL IDs VALID - Safe to proceed with story creation"
echo ""
echo "Use in your JSON as:"
echo '  "additionalAttributes": {'
echo "    \"customfield_10972\": {\"id\": \"$TEAM_ID\"},"
echo "    \"customfield_10970\": {\"id\": \"$COMPONENT_ID\"}"
echo '  }'
Example Usage:

# Validate Control-Freaks + Control Interface
./validate-ids.sh 11560 11554

# Output:
# ✅ Team ID: 11560 (Control-Freaks) - VALID
# ✅ Component ID: 11554 (Control Interface) - VALID
# ✅ ALL IDs VALID - Safe to proceed with story creation
