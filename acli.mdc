Complete Workflow Example
Here's a complete workflow for creating an epic with stories:

#!/bin/bash

# Step 1: Create an epic (if needed)
cat > /tmp/epic.json << 'EOF'
{
  "projectKey": "CCE",
  "type": "Epic",
  "summary": "User Authentication System",
  "description": {
    "version": 1,
    "type": "doc",
    "content": [
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Summary"}]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Implement a complete user authentication system with JWT tokens, session management, and secure password handling."
          }
        ]
      }
    ]
  },
  "additionalAttributes": {
    "customfield_10972": {"id": "11560"},
    "customfield_10970": {"id": "11554"}
  }
}
EOF

EPIC_KEY=$(acli jira workitem create --from-json /tmp/epic.json | grep -oE 'CCE-[0-9]+')
echo "Created epic: $EPIC_KEY"

# Step 2: Create stories under the epic
declare -a STORIES=(
  "DB: User authentication schema"
  "API: Login endpoint implementation"
  "API: Token refresh endpoint"
  "UI: Login form component"
  "Backend: Password hashing service"
)

for STORY in "${STORIES[@]}"; do
  cat > /tmp/story.json << EOF
{
  "projectKey": "CCE",
  "type": "Story",
  "summary": "$STORY",
  "description": {
    "content": [
      {
        "content": [{"text": "Implementation details for: $STORY", "type": "text"}],
        "type": "paragraph"
      }
    ],
    "type": "doc",
    "version": 1
  },
  "parentIssueId": "$EPIC_KEY",
  "additionalAttributes": {
    "customfield_10972": {"id": "11560"},
    "customfield_10970": {"id": "11554"}
  }
}
EOF
  
  STORY_KEY=$(acli jira workitem create --from-json /tmp/story.json | grep -oE 'CCE-[0-9]+')
  echo "Created story: $STORY_KEY - $STORY"
done

# Step 3: Verify all stories were created
echo ""
echo "All stories under epic $EPIC_KEY:"
acli jira workitem search --jql "parent = $EPIC_KEY" --fields "key,summary"
Tips for AI Assistants
🚨 CRITICAL: Double-check field IDs EVERY TIME

customfield_10972 = TEAM IDs (11559, 11560, 11561)
customfield_10970 = COMPONENT IDs (11554, 11555, 11556, 11557, 11558)
Using the wrong ID in the wrong field is the #1 cause of failures!
